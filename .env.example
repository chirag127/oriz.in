# ORIZ.IN environment template.
# This example file is public. Never put real credentials in it.
#
# The private .env is encrypted to .env.sops with SOPS + age using .sops.yaml.
# The age private key is kept outside Git. See AGENTS.md for the local
# decryption and re-encryption workflow.
#
# Optional analytics: disabled unless the flag and a valid provider ID are set.
PUBLIC_ANALYTICS_ENABLED=false
# PUBLIC_GA4_ID=G-XXXXXXXXXX
# PUBLIC_CLARITY_ID=xxxxxxxxxx

# AdSense: disabled until explicitly configured after approval.
PUBLIC_ADSENSE_ENABLED=false
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# PUBLIC_ADSENSE_SLOT=XXXXXXXXXX
