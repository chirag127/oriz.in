---
import type { CategorySummary } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  category: CategorySummary;
}

const { category } = Astro.props;
const href = category.url;
const articleLabel = `${category.articleCount} ${category.articleCount === 1 ? 'guide' : 'guides'}`;
const toolLabel = `${category.toolCount} ${category.toolCount === 1 ? 'tool' : 'tools'}`;
---

<a class="category-card card card--link" href={href}>
  <span class="card-icon" aria-hidden="true">
    <Icon name={category.icon} size={20} />
  </span>
  <p class="card-kicker">{category.domainTitle}</p>
  <h3 class="card-title">{category.name}</h3>
  <p class="card-description">{category.description}</p>
  <div class="card-foot">
    <span>{articleLabel} · {toolLabel}</span>
    <span class="card-arrow" aria-hidden="true">
      <Icon name="arrow-up-right" size={16} />
    </span>
  </div>
</a>
