---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import type { BreadcrumbItem } from '../lib/seo';
import { organizationSchema, websiteSchema } from '../lib/seo';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
  includeSiteSchema?: boolean;
  bodyClass?: string;
  relMe?: string[];
  canonical?: string;
}

const {
  title,
  description,
  type = 'website',
  image,
  noindex = false,
  publishedTime,
  modifiedTime,
  keywords,
  jsonLd = [],
  breadcrumbs,
  includeSiteSchema = false,
  bodyClass = '',
  relMe,
  canonical,
} = Astro.props;

const schema = includeSiteSchema ? [organizationSchema(), websiteSchema(), ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang={SITE.language} dir="ltr">
  <head>
    <script is:inline src="/theme-init.js"></script>
    <BaseHead
      title={title}
      description={description}
      type={type}
      image={image}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
      jsonLd={schema}
      breadcrumbs={breadcrumbs}
      relMe={relMe}
      canonical={canonical}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="container breadcrumbs-bar">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script is:inline defer src="/theme.js"></script>
  </body>
</html>
