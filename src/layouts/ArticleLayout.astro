---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import AuthorBox from '../components/AuthorBox.astro';
import SupportNote from '../components/SupportNote.astro';
import AdSlot from '../components/AdSlot.astro';
import LibrarySidebar from '../components/LibrarySidebar.astro';
import {
  type Article,
  articleLocation,
  articleReadingMinutes,
  articleUrl,
  formatDate,
  getAdjacentArticles,
  getArticleSeries,
  getArticleTools,
  getGuide,
  getRelatedArticles,
} from '../lib/content';
import { getCategory, getCategoryPath, getDomain } from '../data/taxonomy';
import { articleSchema, absoluteUrl } from '../lib/seo';
import { SITE } from '../consts';

interface Props {
  entry: Article;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const location = articleLocation(entry);
const category = getCategory(location.category);
const domain = getDomain(location.domain);
if (!category || !domain) throw new Error(`Article “${entry.id}” has invalid taxonomy.`);
const categoryPath = getCategoryPath(category.slug);
if (!categoryPath) throw new Error(`Category “${category.slug}” has no path.`);
const guide = await getGuide(category.slug);
const path = articleUrl(entry);
const readingMinutes = articleReadingMinutes(entry);
const related = await getRelatedArticles(entry);
const relatedTools = await getArticleTools(entry);
const { previous, next } = await getAdjacentArticles(entry);
const series = await getArticleSeries(entry);
const canonicalUrl = absoluteUrl(path);
const ogImage = entry.data.image ?? guide?.data.heroImage;
const shareTitle = encodeURIComponent(entry.data.title);
const shareUrl = encodeURIComponent(canonicalUrl);
const shareLinks = [
  {
    label: 'Share on X',
    href: `https://x.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`,
    external: true,
  },
  {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
    external: true,
  },
  {
    label: 'Email',
    href: `mailto:?subject=${shareTitle}&body=${shareUrl}`,
    external: false,
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Library', href: '/library/' },
  { label: domain.title, href: `/${domain.slug}/` },
  { label: category.title, href: categoryPath },
  { label: entry.data.title },
];

const jsonLd = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.description,
    path,
    pubDate: entry.data.pubDate,
    updatedDate: entry.data.updatedDate,
    categories: [domain.title, category.title],
    tags: entry.data.tags,
    image: ogImage,
  }),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  noindex={entry.data.noindex}
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  keywords={entry.data.tags}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  canonical={entry.data.canonical}
  image={ogImage}
  bodyClass="article-page"
>
  <article>
    <header class="article-header">
      <div class="container">
        <div class="article-header-inner">
          <div class="article-topline">
            <a href={`/${domain.slug}/`}>{domain.title}</a>
            <span class="meta-dot" aria-hidden="true"></span>
            <a href={categoryPath}>{category.title}</a>
            <span class="meta-dot" aria-hidden="true"></span>
            <time datetime={entry.data.pubDate.toISOString()}>
              {formatDate(entry.data.pubDate)}
            </time>
            <span class="meta-dot" aria-hidden="true"></span>
            <span>{readingMinutes} min read</span>
            {entry.data.difficulty && (
              <>
                <span class="meta-dot" aria-hidden="true"></span>
                <span>{entry.data.difficulty}</span>
              </>
            )}
            {entry.data.legal && (
              <>
                <span class="meta-dot" aria-hidden="true"></span>
                <span class="badge badge--quiet">Legal: {entry.data.legal}</span>
              </>
            )}
          </div>
          {series.articles.length > 1 && (
            <p class="article-series-kicker">
              {series.series.title} · Part {series.position} of {series.articles.length}
            </p>
          )}
          <h1>{entry.data.title}</h1>
          <p class="article-summary">{entry.data.description}</p>
          <div class="article-byline">
            <span>By <a href={SITE.authorUrl}>{entry.data.author}</a></span>
            {entry.data.updatedDate && (
              <>
                <span class="meta-dot" aria-hidden="true"></span>
                <span>Updated {formatDate(entry.data.updatedDate)}</span>
              </>
            )}
            <span class="meta-dot" aria-hidden="true"></span>
            <span>{entry.data.type}</span>
          </div>
          {entry.data.tags.length > 0 && (
            <div class="chips article-tags">
              {entry.data.tags.map((tag) => (
                <span class="chip">{tag.replaceAll('-', ' ')}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="container article-layout article-layout--library">
      <LibrarySidebar
        currentDomain={location.domain}
        currentCategory={location.category}
        currentSeries={location.series}
        currentArticle={entry.id}
      />

      <div class="article-main">
        {(entry.data.image || entry.data.disclaimer) && (
          <div class="article-lede">
            {entry.data.image && (
              <figure class="article-hero">
                <img
                  src={entry.data.image}
                  alt={entry.data.imageAlt}
                  width={entry.data.imageWidth}
                  height={entry.data.imageHeight}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </figure>
            )}
            {entry.data.disclaimer && (
              <div class="article-disclaimer" role="note">
                <strong>Educational note</strong>
                {entry.data.disclaimer}
              </div>
            )}
          </div>
        )}

        {entry.data.contentWarnings.length > 0 && (
          <div class="tool-info" role="note">
            <strong>Content note:</strong>{' '}
            {entry.data.contentWarnings.join(' ')}
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        <div class="article-footer">
          {entry.data.source && (
            <p class="article-source-note">
              Adapted from{' '}
              {entry.data.source.url ? (
                <a href={entry.data.source.url} rel="noopener noreferrer">{entry.data.source.title}</a>
              ) : (
                entry.data.source.title
              )}
              {entry.data.source.license ? ` (${entry.data.source.license})` : ''}. This version is maintained in the ORIZ.IN library.
            </p>
          )}

          {entry.data.references.length > 0 && (
            <section class="article-footer-section" aria-labelledby="references-heading">
              <h2 id="references-heading">References</h2>
              <ol class="article-references">
                {entry.data.references.map((reference) => (
                  <li>
                    {reference.url ? (
                      <a href={reference.url} rel="noopener noreferrer">{reference.title}</a>
                    ) : (
                      reference.title
                    )}
                    {reference.note && <span> — {reference.note}</span>}
                  </li>
                ))}
              </ol>
            </section>
          )}

          <AdSlot />
          <SupportNote />

          <section class="article-footer-section" aria-label="About the author">
            <AuthorBox />
          </section>

          {related.length > 0 && (
            <section class="article-footer-section" aria-labelledby="related-heading">
              <h2 id="related-heading">Continue reading</h2>
              <div class="related-grid">
                {related.map((item) => (
                  <a class="related-link" href={articleUrl(item)}>
                    {item.data.title}
                    <span>{item.data.description}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {relatedTools.length > 0 && (
            <section class="article-footer-section" aria-labelledby="related-tools-heading">
              <h2 id="related-tools-heading">Tools mentioned</h2>
              <div class="article-tools-list">
                {relatedTools.map((tool) => (
                  <a href={`/tools/${tool.slug}/`}>
                    {tool.title}
                    <span>{tool.description}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="article-footer-section" aria-label="Article navigation">
            <div class="prevnext">
              {previous && (
                <a href={articleUrl(previous)}>
                  <span class="prevnext-label">Previous in series</span>
                  <span class="prevnext-title">{previous.data.title}</span>
                </a>
              )}
              {next && (
                <a href={articleUrl(next)}>
                  <span class="prevnext-label">Next in series</span>
                  <span class="prevnext-title">{next.data.title}</span>
                </a>
              )}
            </div>
            <p class="article-license">
              This article is licensed under {entry.data.license}. Author:{' '}
              <a href={SITE.authorUrl}>{entry.data.author}</a>. Canonical URL:{' '}
              <a href={canonicalUrl}>{canonicalUrl}</a>.
            </p>
          </section>
        </div>
      </div>

      <aside class="article-aside">
        {entry.data.keyPoints.length > 0 && (
          <div class="side-card aside-keypoints">
            <h2>Key takeaways</h2>
            <ul>
              {entry.data.keyPoints.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        )}

        {entry.data.toc && <Toc headings={headings} />}

        {guide && (
          <div class="side-card">
            <h2>Complete guide</h2>
            <p>
              <a href={categoryPath}>{guide.data.title}</a>
            </p>
            <p class="side-card-note">
              The guide covers the whole category and puts this article in context.
            </p>
          </div>
        )}

        {series.articles.length > 1 && (
          <div class="side-card">
            <h2>{series.series.title}</h2>
            <ol class="aside-series-list">
              {series.articles.map((item) => (
                <li>
                  <a href={articleUrl(item)} aria-current={item.id === entry.id ? 'page' : undefined}>
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}

        {relatedTools.length > 0 && (
          <div class="side-card aside-tools">
            <h2>Tools in this article</h2>
            <ul>
              {relatedTools.map((tool) => (
                <li><a href={`/tools/${tool.slug}/`}>{tool.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="side-card aside-share">
          <h2>Share this article</h2>
          <div class="aside-share-links">
            {shareLinks.map((link) => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <div class="side-card aside-explore">
          <h2>More in {category.title}</h2>
          <p>
            Browse <a href={categoryPath}>{category.title}</a> or open the{' '}
            <a href="/library/">whole library</a>.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  import { enhanceArticles } from '../scripts/enhance-article';
  enhanceArticles();
</script>
